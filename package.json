{
  "name": "ach-safe-vault",
  "version": "1.0.0",
  "description": "My application to safely save passwords.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [
    "ach",
    "safe",
    "vault",
    "password",
    "lotr",
    "achraf",
    "bounane"
  ],
  "author": "achBou",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "bootstrap-icons": "^1.10.2"
  },
  "build": {
    "appId": "com.ach.safevault",
    "productName": "Ach Safe Vault",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "entries.js",
      "vault-store.js",
      "strength.js",
      "index.html",
      "style.css",
      "theme.css",
      "screens/**/*",
      "windows/**/*",
      "resources/**/*",
      "node_modules/bootstrap-icons/font/**/*",
      "package.json",
      "!node_modules/bootstrap-icons/icons/**",
      "!node_modules/bootstrap-icons/bootstrap-icons.svg",
      "!node_modules/bootstrap-icons/font/*.scss",
      "!node_modules/bootstrap-icons/font/*.json",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
